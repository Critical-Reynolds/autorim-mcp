<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AutoRim</AssemblyName>
    <RootNamespace>AutoRim</RootNamespace>
    <Version>0.1.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <!-- The mod ships a single DLL; nothing else may land in Assemblies/. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <ModDeployDir>$(MSBuildProjectDirectory)\..\dist-mod\AutoRim</ModDeployDir>
  </PropertyGroup>

  <!-- Target the shared API. RimWorld 1.7 redirects Unity references to its Waylith stubs. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" PrivateAssets="all" IncludeAssets="compile" />
  </ItemGroup>

  <Target Name="DeployToModFolder" AfterTargets="Build">
    <MakeDir Directories="$(ModDeployDir)\Assemblies" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModDeployDir)\Assemblies" />
    <Message Importance="high" Text="[AutoRim] Deployed $(TargetFileName) -> $(ModDeployDir)\Assemblies" />
  </Target>

</Project>
